<?xml version="1.0" ?>
<!--
  ============================================================================
  clinic.sdf  -  Mundo de teste para a cadeira de rodas robotizada
  Gazebo Harmonic (gz-sim)

  Contem:
    - Sistemas necessarios (physics, sensors/ogre2, imu, contact...)
    - Sala fechada ~12x10 m com uma parede interna e uma porta
    - Obstaculos FIXOS: pilares, mesas, caixas
    - Obstaculos MOVEIS: 2 "pessoas" (cilindros) + 1 "carrinho" (caixa)
      Cada movel usa o sistema VelocityControl e assina
      /model/<nome>/cmd_vel ; o no obstacle_mover.py os anima.
  ============================================================================
-->
<sdf version="1.9">
  <world name="clinic">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ===================== SISTEMAS ===================== -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ===================== LUZ ===================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- ===================== CHAO ===================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================================================== -->
    <!--  PAREDES (estaticas)                                  -->
    <!--  Interior util: x in [-6,6], y in [-5,5]              -->
    <!-- ===================================================== -->

    <!-- Parede Norte (y = +5) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.15 0.15 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.15 0.15 1.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parede Sul (y = -5) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.15 0.15 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>12.15 0.15 1.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parede Leste (x = +6) -->
    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 10.15 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 10.15 1.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parede Oeste (x = -6) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 10.15 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 10.15 1.5</size></box></geometry>
          <material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parede interna em x = -1.5, dividida em dois trechos,
         deixando uma PORTA de ~1.8 m em y in [-0.9, 0.9] -->
    <model name="wall_partition_lower">
      <static>true</static>
      <pose>-1.5 -2.75 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 4.5 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 4.5 1.5</size></box></geometry>
          <material><ambient>0.78 0.76 0.72 1</ambient><diffuse>0.78 0.76 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_partition_upper">
      <static>true</static>
      <pose>-1.5 2.75 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 4.5 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 4.5 1.5</size></box></geometry>
          <material><ambient>0.78 0.76 0.72 1</ambient><diffuse>0.78 0.76 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================================================== -->
    <!--  OBSTACULOS FIXOS                                     -->
    <!-- ===================================================== -->

    <!-- Pilares (cilindros altos) -->
    <model name="pillar_1">
      <static>true</static>
      <pose>2 2 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static>
      <pose>3 -2 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_3">
      <static>true</static>
      <pose>-3.5 2.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.8</length></cylinder></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mesas (caixas na altura de uma mesa) -->
    <model name="table_1">
      <static>true</static>
      <pose>4 3 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.6 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.6 0.75</size></box></geometry>
          <material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="table_2">
      <static>true</static>
      <pose>-4 -3.2 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.6 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.6 0.75</size></box></geometry>
          <material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.45 0.30 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Caixas no chao -->
    <model name="box_1">
      <static>true</static>
      <pose>1.0 -3.5 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material><ambient>0.75 0.6 0.2 1</ambient><diffuse>0.75 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>-3.5 0.2 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material><ambient>0.75 0.6 0.2 1</ambient><diffuse>0.75 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================================================== -->
    <!--  OBSTACULOS MOVEIS                                    -->
    <!--  Cada um tem VelocityControl e assina                 -->
    <!--  /model/<nome>/cmd_vel (gz.msgs.Twist).               -->
    <!--  O no obstacle_mover.py inverte a velocidade em ciclo.-->
    <!-- ===================================================== -->

    <!-- Pessoa A: patrulha ao longo de X, atravessa a porta (y=0) -->

    <!-- Pessoa B: patrulha ao longo de Y no lado leste -->

    <!-- Carrinho: patrulha ao longo de X no lado norte -->
    <model name="cart">
      <pose>0.5 3.5 0.25 0 0 0</pose>
      <link name="link">
        <kinematic>true</kinematic>
        <inertial>
          <mass>20.0</mass>
          <inertia><ixx>0.8</ixx><iyy>1.2</iyy><izz>1.4</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.6 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.4 0.5</size></box></geometry>
          <material><ambient>0.2 0.35 0.6 1</ambient><diffuse>0.2 0.35 0.6 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl"/>
    </model>

  </world>
</sdf>
